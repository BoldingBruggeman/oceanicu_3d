#!/bin/bash
# Wrapper so `reap-orphaned-chunks` works from anywhere once running/bin
# is on PATH -- see EXPERIMENT_TRACKING.md and relay.env.example. Just
# forwards to the real script, which lives one directory up from this
# one; pure stdlib, no conda env needed for this one. Mainly useful for
# a manual/urgent invocation on the HPC's login node -- the crontab line
# itself still uses a full path, since cron doesn't source ~/.bashrc and
# won't see PATH additions made there (same caveat as the plain .sh
# scripts in this same directory, e.g. restart_registry_watcher.sh).
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
exec python3 "$(dirname "$SELF")/../reap_orphaned_chunks.py" "$@"
