# Copy this file to relay.env (gitignored) and `source` it on a workstation:
# list/show (and --dry-run) then read the registry mirror on the relay, as a
# read-only snapshot fetched over ssh; changes go through the command queue
# (--queue). See EXPERIMENT_TRACKING.md "Reading the registry from another
# machine".
#
# `oceanicu-relay` is a Host alias in this machine's ~/.ssh/config, where the
# per-machine differences (username, IdentityFile, ProxyJump, ...) belong:
#
#   Host oceanicu-relay
#       HostName bb-server1
#       User your-username-on-the-relay
#
# Without such an alias, write user@relay-host instead.

# Filename convention is submission_registry.sqlite, not experiment_
# registry.sqlite (that name may belong to a separate reporting DB in the
# same directory).
export OCEANICU_EXPERIMENT_DB=ssh://oceanicu-relay/abs/path/to/submission_registry.sqlite

# Short commands (oceanicu-experiments, chunk-runner) from anywhere.
export PATH="$HOME/source/repos/OceanICU/oceanicu_3d/running/bin:$PATH"
