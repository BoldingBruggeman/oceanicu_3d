# Copy this file to relay.env (gitignored) and `source` it -- same content
# on every machine that talks to the registry through the relay. See
# EXPERIMENT_TRACKING.md's "Working across machines" section.
#
# This only works out of the box if `oceanicu-relay` is defined as a
# Host alias in THIS machine's ~/.ssh/config -- that's where the actual
# per-machine differences (username, IdentityFile, ProxyJump, ...)
# belong, not here. Example ~/.ssh/config stanza:
#
#   Host oceanicu-relay
#       HostName bb-server1
#       User your-username-on-the-relay
#
# Without such an alias, replace `oceanicu-relay` below with a literal
# user@relay-host instead -- see EXPERIMENT_TRACKING.md for why the alias form
# is recommended over that.

export OCEANICU_EXPERIMENT_DB=ssh://oceanicu-relay/data/OceanICU/oceanicu_3d/experiments/experiment_registry.sqlite
export OCEANICU_RELAY_DIR=/data/OceanICU/oceanicu_3d/experiments

# Short commands (oceanicu-experiments, chunk-runner) from anywhere -- e.g.
# from inside an experiment's own chunk directory, without the full path to
# oceanicu_3d/running/*.py every time. Same repo, same path on every
# machine (see EXPERIMENT_TRACKING.md), so this line doesn't need to change
# per-machine either.
export PATH="$HOME/source/repos/OceanICU/oceanicu_3d/running/bin:$PATH"
