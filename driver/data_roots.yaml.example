# See README.md ("data_roots.yaml.example") for what this is and how it's used.
# Every *_CMIP6 variable below (boundaries.barotropic/baroclinic, meteo,
# river_discharge) is a real parent folder -- the matching domain config's own
# CMIP6.folder_template appends {model}/{scenario} onto it, unlike e.g. ERA5_FOLDER.

# domain
BATHYMETRY_FOLDER: /home/kb/source/repos/OceanICU/oceanicu_3d/NSe/Bathymetry

# hydrography
HYDROGRAPHY_FOLDER_WOA: /data/WOA
# HYDROGRAPHY_FOLDER_CMEMS not verified against bb-server1's real layout this
# session (unlike the WOA/TPXO/boundary CMEMS paths below, which were) --
# left as this local machine's own value; may need the same kind of fix.
HYDROGRAPHY_FOLDER_CMEMS: /home/kb/source/repos/boundaries.old

# boundaries.barotropic
TPXO_FOLDER: /data/TPXO9
# Real, live CMEMS extraction on bb-server1 (contains both daily_*.nc and
# hourly_*.nc in the same folder -- confirmed this session, see
# lib/boundaries/delta_change.py's load_ref_dataset). NOT this local
# machine's stale ./boundaries.old snapshot the .example previously pointed
# at, which doesn't exist on bb-server1 at all.
BOUNDARY_FOLDER_BAROTROPIC_CMEMS: /data/OceanICU/oceanicu_3d/data/NSe/CMEMS/bdy
BOUNDARY_FOLDER_BAROTROPIC_CMIP6: /data/OceanICU/oceanicu_3d/data/NSe/CMIP6

# boundaries.baroclinic
BOUNDARY_FOLDER_BAROCLINIC_WOA: /data/WOA
BOUNDARY_FOLDER_BAROCLINIC_CMEMS: /data/OceanICU/oceanicu_3d/data/NSe/CMEMS/bdy
# ocean-prep's run-delta-boundaries output (NOT /data/CMIP6, which is the raw
# CMIP6 extraction location -- delta-change-corrected boundary files live
# under NSe/CMIP6/{model}/{scenario}/bdy/ instead).
BOUNDARY_FOLDER_BAROCLINIC_CMIP6: /data/OceanICU/oceanicu_3d/data/NSe/CMIP6

# meteo
ERA5_FOLDER: /data/ERA5
CMIP6_FOLDER: /data/BiasCorrected
# Raw (not bias-corrected) CMIP6 archive, fetched via ocean-data's
# DataLoader straight from Pangeo/ESGF -- meteo.CMIP6-raw's own
# folder_template ('{model}/{scenario}') appends directly onto this, no
# extra "CMIP6" path segment needed (unlike CMIP6_FOLDER above).
CMIP6_RAW_FOLDER: /data/CMIP6

# river_discharge
RIVER_FOLDER: /data/EMORID
RIVER_FOLDER_CMIP6: /data/BiasCorrected

# boundaries.fabm / fabm -- real files (ADY_gle.nc, Ndep/, woa_{i,n,o,p}.nc)
# sit directly under /data/FABM, not /data/FABM/ERSEM (that subfolder
# never existed).
FABM_ERSEM_FOLDER: /data/FABM
BOUNDARY_FOLDER_FABM_WOA: /data/FABM/WOA
BOUNDARY_FOLDER_FABM_CMEMS: /data/OceanICU/oceanicu_3d/data/NSe/CMEMS/bdy
# Same root as BOUNDARY_FOLDER_BAROCLINIC_CMIP6 -- bio boundary files
# (bdy_3d_<var>_<method>_<start>_<end>.nc, generated 2026-09-21/22) sit in
# the identical <model>/<scenario>/bdy/ tree as thetao/so's own CMIP6
# output. Kept as its own named var (not a reuse of BOUNDARY_FOLDER_
# BAROCLINIC_CMIP6) to match every other per-role FABM/baroclinic pair
# above, even though the real value happens to be identical today.
BOUNDARY_FOLDER_FABM_CMIP6: /data/OceanICU/oceanicu_3d/data/NSe/CMIP6
# Atmospheric CO2 (and, once wired, N2O) for FABM's mole_fraction_of_
# carbon_dioxide_in_air/partial_pressure_of_n2o dependencies -- real,
# verified data (2026-09-23): the input4MIPs GHG concentration pathway,
# same file for every CMIP6 model, fetched via ocean_data.esgf_loader.
# ESGFLoader.search_input4mips and saved once per scenario as co2_
# {scenario}.nc (tiny, ~300KB each -- see driver/scripts/fabm.py's own
# configure_fabm for the real path/naming this reads).
GHG_CONCENTRATION_FOLDER: /data/OceanICU/oceanicu_3d/data/atmos/ghg_concentrations
# fabm.<source>.file (fabm_ersem.yaml, fabm_mizer.yaml) is deliberately a
# BARE relative filename in the config, not a ${VAR}-resolved path --
# these are project-specific CONFIG, not shared external data (so they
# don't live under /data/FABM), and may vary between simulations, so
# each run gets its OWN copy sitting right next to its own generated_*.
# {py,yaml} (same directory, same cwd the run itself executes from) --
# never a single shared path multiple runs would read from. Canonical,
# git-tracked source to copy from: /data/OceanICU/oceanicu_3d/
# experiments/NSe/fabm_{ersem,mizer}.yaml.

# data_assignments (radiation.kc2, when ObsKd/space-varying is active)
KD490_FOLDER: /data/Kd490

# output
OUTPUT_FOLDER: .

# driver plumbing -- oceanicu_driver.py already defaults these via
# os.environ.setdefault when run from source; only needed for a
# --dump-python'd script run from elsewhere.
GOTM_FOLDER: /home/kb/source/repos/OceanICU/oceanicu_3d
SCRIPT_FOLDER: /home/kb/source/repos/OceanICU/oceanicu_3d/driver/scripts
